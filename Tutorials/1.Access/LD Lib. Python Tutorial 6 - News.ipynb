      "\n",
      "get_headlines(query: str, count: int = 10, start: 'OptDateTime' = None, end: 'OptDateTime' = None, order_by: Union[str, lseg.data.content.news.headlines._sort_order.SortOrder] = <SortOrder.new_to_old: 'newToOld'>) -> pandas.core.frame.DataFrame\n",
